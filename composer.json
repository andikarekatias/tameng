{
    "name": "andika/tameng",
    "version": "1.1.0",
    "description": "Custom Filament plugin for role and permission management",
    "keywords": [
        "andika",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "tameng"
    ],
    "homepage": "https://github.com/andikarekatias/tameng",
    "support": {
        "issues": "https://github.com/andikarekatias/tameng/issues",
        "source": "https://github.com/andikarekatias/tameng"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "andikarekatias",
            "email": "andika.rekatias@yahoo.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Andika\\Tameng\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Andika\\Tameng\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Andika\\Tameng\\TamengServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "prefer-stable": true
    }
}
